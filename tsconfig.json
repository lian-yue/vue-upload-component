{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "jsx": "preserve",
        "importHelpers": true,
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "declaration": true,
        "types": [
            "node",
            "webpack-env"
        ],
        "lib": [
            "esnext",
            "dom",
            "scripthost"
        ]
    },
    "include": [
        "./src/*.ts",
        "./src/*.vue",
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./src/**/*.vue",
        "./src/views/*.vue"
    ],
    "exclude": [
        "node_modules"
    ]
}
