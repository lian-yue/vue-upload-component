{
  "name": "vue-upload-component",
  "description": "Vue.js file upload component, Multi-file upload, Upload directory, Drag upload, Drag the directory, Upload multiple files at the same time, html4 (IE 9), `PUT` method, Customize the filter",
  "version": "3.2.2",
  "author": "LianYue",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --hot",
    "build": "npm run build-rollup && npm run build-webpack",
    "build-webpack": "cross-env NODE_ENV=production webpack --no-watch --progress",
    "build-rollup": "cross-env NODE_ENV=production rollup --config rollup.config.mjs && mv ./dist/FileUpload.vue.d.ts ./dist/vue-upload-component.d.ts && cp ./dist/vue-upload-component.d.ts ./src/FileUpload.vue.d.ts && rm ./dist/index.d.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "main": "dist/vue-upload-component.js",
  "module": "dist/vue-upload-component.esm.js",
  "unpkg": "dist/vue-upload-component.js",
  "jsdelivr": "dist/vue-upload-component.js",
  "typings": "dist/vue-upload-component.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lian-yue/vue-upload-component.git"
  },
  "keywords": [
    "javascript",
    "vue3",
    "vue 3",
    "vue",
    "vue.js",
    "component",
    "file",
    "uploader",
    "directory",
    "multiple",
    "upload",
    "upload-directory",
    "chunk",
    "drag",
    "drag-directory",
    "upload-directory",
    "vue-component",
    "vue-upload-component"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "vue": "^3.5.41"
  },
  "bugs": {
    "url": "https://github.com/lian-yue/vue-upload-component/issues"
  },
  "homepage": "https://github.com/lian-yue/vue-upload-component#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.2.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "babel-loader": "^10.1.1",
    "compressorjs": "^1.3.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-webpack-plugin": "^6.0.0",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "marked": "^18.0.9",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "rollup-plugin-vue": "^6.0.0",
    "spark-md5": "^3.0.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-loader": "^17.4.2",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9",
    "vuex": "^4.1.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "rollup-plugin-postcss": {
      "cssnano": "^7.1.9"
    }
  }
}
